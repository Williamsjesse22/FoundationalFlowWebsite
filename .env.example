# Contact form delivery (Resend). Set these in Vercel > Project > Settings > Environment Variables.
# Without RESEND_API_KEY the form shows the direct email address instead of sending.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Foundational Flow <website@foundationalflow.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives form submissions
CONTACT_TO_EMAIL=
